//link state routing algorithm (nothing but a dijkastra's algorithm)
#include <iostream>
using namespace std;

int main() {
    int cost[20][20], dist[20], visited[20], n, source;

    cout << "Enter number of routers: ";
    cin >> n;

    cout << "Enter the cost matrix (0 for no link):\n";
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> cost[i][j];
            if (cost[i][j] == 0 && i != j)
                cost[i][j] = 999;
        }
    }

    cout << "Enter source router: ";
    cin >> source;

    // Initialize distance and visited arrays
    for (int i = 0; i < n; i++) {
        dist[i] = cost[source][i];
        visited[i] = 0;
    }

    dist[source] = 0;
    visited[source] = 1;

    // Dijkstra’s Algorithm
    for (int count = 1; count < n - 1; count++) {
        int min = 999, nextNode = -1;

        // Find the nearest unvisited node
        for (int i = 0; i < n; i++) {
            if (!visited[i] && dist[i] < min) {
                min = dist[i];
                nextNode = i;
            }
        }

        visited[nextNode] = 1;

        // Update distances of neighbors
        for (int i = 0; i < n; i++) {
            if (!visited[i]) {
                if (min + cost[nextNode][i] < dist[i])
                    dist[i] = min + cost[nextNode][i];
            }
        }
    }

    // Display results
    cout << "\nShortest distance from router " << source << ":\n";
    for (int i = 0; i < n; i++) {
        cout << "To router " << i << " = " << dist[i] << endl;
    }

    return 0;
}
